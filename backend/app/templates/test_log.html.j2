<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <title>{{ identifier }} - {{ run.name }}</title>
  <style>
    @page {
      size: A4;
      margin: 20mm;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      color: #1f2937;
      line-height: 1.5;
      font-size: 13px;
      margin: 0;
      padding: 24px;
    }
    header {
      border-bottom: 2px solid #0f766e;
      padding-bottom: 12px;
      margin-bottom: 20px;
    }
    h1 {
      margin: 0 0 6px 0;
      font-size: 22px;
      color: #111827;
    }
    h2 {
      margin-top: 22px;
      margin-bottom: 8px;
      font-size: 16px;
      color: #0f766e;
      border-bottom: 1px solid #e5e7eb;
      padding-bottom: 4px;
    }
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 12px;
      color: #4b5563;
    }
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: 600;
      font-size: 11px;
      background: #ccfbf1;
      color: #115e59;
    }
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 8px;
      margin-bottom: 14px;
    }
    .metric-card {
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      padding: 8px 12px;
      background: #f9fafb;
    }
    .metric-label {
      font-size: 11px;
      color: #6b7280;
    }
    .metric-value {
      font-size: 16px;
      font-weight: 700;
      color: #111827;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      margin-bottom: 16px;
      font-size: 12px;
    }
    th, td {
      border: 1px solid #d1d5db;
      padding: 6px 8px;
      text-align: left;
      vertical-align: top;
    }
    th {
      background: #f3f4f6;
      font-weight: 600;
    }
    footer {
      margin-top: 28px;
      padding-top: 10px;
      border-top: 1px solid #e5e7eb;
      font-size: 11px;
      color: #6b7280;
    }
  </style>
</head>
<body>
  <header>
    <h1>IEEE 829 Test Log · {{ identifier }} — {{ run.name }}</h1>
    <div class="meta">
      <span><strong>Test Log ID:</strong> {{ identifier }}</span>
      <span><strong>Koşum (Test Run):</strong> #{{ run.id }} ({{ run.name }})</span>
      <span><strong>Proje:</strong> {{ project.name }}</span>
      <span><strong>Sürüm (Release):</strong> {{ release.version if release else "Genel" }}</span>
      <span><strong>Test Suite:</strong> {{ suite.name if suite else "Genel" }}</span>
      <span><strong>Başlatan:</strong> {{ run.created_by }}</span>
      <span><strong>Koşum Zamanı:</strong> {{ run.created_at }}</span>
      <span><strong>Üretim Zamanı:</strong> {{ generated_at }}</span>
    </div>
  </header>

  <section>
    <h2>1. Test Log Tanımlayıcısı ve Kapsamı (IEEE 829 / ISO/IEC/IEEE 29119-3)</h2>
    <p>
      Bu doküman <strong>{{ identifier }}</strong> koduyla <strong>{{ project.name }}</strong> projesinin
      <strong>#{{ run.id }} ({{ run.name }})</strong> test koşumu yürütme kayıtlarını, zaman damgalarını,
      gerçekleşen sonuçları ve tetiklenen olay (defect) bağlantılarını IEEE 829 Test Log ve
      ISO/IEC/IEEE 29119-3 Test Execution Log yapısına uygun olarak kayıt altına alır.
    </p>
  </section>

  <section>
    <h2>2. Koşum Sonuç Özeti (Execution Summary)</h2>
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-label">Planlanan / Yürütülen</div>
        <div class="metric-value">{{ summary.executed }} / {{ summary.total }} (%{{ summary.execution_rate }})</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Passed / Failed</div>
        <div class="metric-value">{{ summary.passed }} / {{ summary.failed }}</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Blocked / Skipped / Not Run</div>
        <div class="metric-value">{{ summary.blocked }} / {{ summary.skipped }} / {{ summary.not_run }}</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Kesin Başarı Oranı (Pass Rate)</div>
        <div class="metric-value">%{{ summary.pass_rate }}</div>
      </div>
    </div>
  </section>

  <section>
    <h2>3. Kronolojik Yürütme Kayıtları (Activity &amp; Execution Entries)</h2>
    <table>
      <thead>
        <tr>
          <th>Yürütme ID</th>
          <th>Test Vakası</th>
          <th>Gereksinimler</th>
          <th>Sonuç (Status)</th>
          <th>Beklenen Sonuç</th>
          <th>Gerçekleşen Sonuç (Actual Result)</th>
          <th>Notlar</th>
          <th>Yürüten &amp; Zaman</th>
          <th>İlgili Defect'ler</th>
        </tr>
      </thead>
      <tbody>
        {% for ex in executions %}
        <tr>
          <td>#{{ ex.id }}</td>
          <td><strong>{{ ex.test_case_id }}</strong> — {{ ex.test_case_title }}</td>
          <td>{{ ex.requirements | join(", ") if ex.requirements else "-" }}</td>
          <td><span class="badge">{{ ex.status }}</span></td>
          <td>{{ ex.expected_result or "-" }}</td>
          <td>{{ ex.actual_result or "-" }}</td>
          <td>{{ ex.notes or "-" }}</td>
          <td>{{ ex.executed_by or "-" }} · {{ ex.executed_at or "Koşulmadı" }}</td>
          <td>
            {% if ex.defect_ids %}
              {% for did in ex.defect_ids %}#{{ did }}{% if not loop.last %}, {% endif %}{% endfor %}
            {% else %}
              -
            {% endif %}
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="9">Bu koşumda kayıtlı yürütme satırı bulunmuyor.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <section>
    <h2>4. Koşumda Kaydedilen Anomaliler ve Test Incident Kayıtları (Anomalous Events)</h2>
    <table>
      <thead>
        <tr>
          <th>Defect ID</th>
          <th>Başlık</th>
          <th>Önem Derecesi</th>
          <th>Durum</th>
          <th>İlgili Test Vakası</th>
        </tr>
      </thead>
      <tbody>
        {% for d in defects %}
        <tr>
          <td><strong>#{{ d.id }}</strong></td>
          <td>{{ d.title }}</td>
          <td>{{ d.severity }}</td>
          <td>{{ d.status }}</td>
          <td>{{ d.test_case or "-" }}</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="5">Bu koşuma bağlı defect kaydı bulunmuyor.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <footer>
    SDS-06 Agile Test and Defect Tracking System · IEEE 829 / ISO/IEC/IEEE 29119-3 Test Log · Üreten: {{ generated_by }}
  </footer>
</body>
</html>
