<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <title>{{ identifier }} - {{ defect.title }}</title>
  <style>
    @page {
      size: A4;
      margin: 20mm;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      color: #1f2937;
      line-height: 1.5;
      font-size: 13px;
      margin: 0;
      padding: 24px;
    }
    header {
      border-bottom: 2px solid #dc2626;
      padding-bottom: 12px;
      margin-bottom: 20px;
    }
    h1 {
      margin: 0 0 6px 0;
      font-size: 22px;
      color: #111827;
    }
    h2 {
      margin-top: 22px;
      margin-bottom: 8px;
      font-size: 16px;
      color: #991b1b;
      border-bottom: 1px solid #e5e7eb;
      padding-bottom: 4px;
    }
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 12px;
      color: #4b5563;
    }
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: 600;
      font-size: 11px;
      background: #fee2e2;
      color: #991b1b;
    }
    .section-box {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      padding: 10px 14px;
      margin-bottom: 12px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      margin-bottom: 16px;
      font-size: 12px;
    }
    th, td {
      border: 1px solid #d1d5db;
      padding: 6px 8px;
      text-align: left;
      vertical-align: top;
    }
    th {
      background: #f3f4f6;
      font-weight: 600;
    }
    ol {
      margin: 4px 0;
      padding-left: 20px;
    }
    footer {
      margin-top: 28px;
      padding-top: 10px;
      border-top: 1px solid #e5e7eb;
      font-size: 11px;
      color: #6b7280;
    }
  </style>
</head>
<body>
  <header>
    <h1>IEEE 829 Test Incident Report · {{ identifier }}</h1>
    <div class="meta">
      <span><strong>Rapor ID:</strong> {{ identifier }}</span>
      <span><strong>Defect ID:</strong> #{{ defect.id }}</span>
      <span><strong>Başlık:</strong> {{ defect.title }}</span>
      <span><strong>Önem (Severity):</strong> <span class="badge">{{ defect.severity }}</span></span>
      <span><strong>Durum (Status):</strong> <span class="badge">{{ defect.status }}</span></span>
      <span><strong>Üreten:</strong> {{ generated_by }}</span>
      <span><strong>Üretim Zamanı:</strong> {{ generated_at }}</span>
    </div>
  </header>

  <section>
    <h2>1. Test Incident Report Tanımlayıcısı ve Özeti (IEEE 829 / ISO/IEC/IEEE 29119-3)</h2>
    <div class="section-box">
      <p><strong>Olay Tanımlayıcısı:</strong> {{ identifier }} (Defect #{{ defect.id }})</p>
      <p><strong>Olay Özeti:</strong> {{ defect.title }}</p>
      <p><strong>Standart Eşlemesi:</strong> IEEE 829 Test Incident Report ↔ ISO/IEC/IEEE 29119-3 Test Incident Report / 29119-2 Test Incident Reporting.</p>
    </div>
  </section>

  <section>
    <h2>2. Olay Açıklaması: Girdiler, Beklenen ve Gerçekleşen Sonuçlar (Incident Description)</h2>
    {% if test_case %}
    <div class="section-box">
      <p><strong>İlgili Test Vakası (Test Case Specification):</strong> {{ test_case.id }} — {{ test_case.title }}</p>
      <p><strong>Test Suite:</strong> {{ test_case.suite_name or "Atanmamış" }} · <strong>Öncelik:</strong> {{ test_case.priority }} · <strong>Otomasyon:</strong> {{ "Evet" if test_case.automated else "Hayır" }} · <strong>Vaka Durumu:</strong> {{ test_case.status }}</p>
      <p><strong>İzlenen Gereksinimler:</strong> {{ test_case.requirements | join(", ") if test_case.requirements else test_case.requirement }}</p>
      <p><strong>Test Adımları (Girdiler ve Prosedür):</strong></p>
      {% if test_case.steps %}
      <ol>
        {% for step in test_case.steps %}
        <li>{{ step }}</li>
        {% endfor %}
      </ol>
      {% else %}
      <p>Test adımı tanımlanmamış.</p>
      {% endif %}
      <p><strong>Beklenen Sonuç (Expected Result):</strong> {{ test_case.expected_result or "Belirtilmedi." }}</p>
    </div>
    {% else %}
    <div class="section-box">
      Doğrudan bağlı bir Test Case Specification kaydı bulunmuyor.
    </div>
    {% endif %}

    {% if requirements %}
    <table>
      <thead>
        <tr>
          <th>Gereksinim Kodu</th>
          <th>Başlık</th>
          <th>Açıklama</th>
        </tr>
      </thead>
      <tbody>
        {% for req in requirements %}
        <tr>
          <td><strong>{{ req.id }}</strong></td>
          <td>{{ req.title }}</td>
          <td>{{ req.description or "-" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}

    <h3>İlişkili Test Yürütmeleri ve Anomaliler (Linked Test Executions)</h3>
    <table>
      <thead>
        <tr>
          <th>Yürütme / Koşum</th>
          <th>Test Vakası</th>
          <th>Sonuç</th>
          <th>Gerçekleşen Sonuç (Actual Result)</th>
          <th>Notlar / Kanıt</th>
          <th>Yürüten &amp; Tarih</th>
        </tr>
      </thead>
      <tbody>
        {% for ex in executions %}
        <tr>
          <td>#{{ ex.id }} ({{ ex.run_name }})</td>
          <td><strong>{{ ex.test_case_id }}</strong></td>
          <td>{{ ex.status }}</td>
          <td>{{ ex.actual_result or "-" }}</td>
          <td>{{ ex.notes or "-" }}</td>
          <td>{{ ex.executed_by or "-" }} · {{ ex.executed_at or "-" }}</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="6">Bu defect ile doğrudan ilişkilendirilmiş test yürütmesi kaydı bulunmuyor.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <section>
    <h2>3. Etki ve Doğrulama Değerlendirmesi (Impact &amp; Verification Gate)</h2>
    <div class="section-box">
      <p><strong>Önem Derecesi (Severity):</strong> {{ defect.severity }}</p>
      <p><strong>Güncel Yaşam Döngüsü Durumu:</strong> {{ defect.status }}</p>
      <p><strong>Kapanış Doğrulama Durumu (Resolved → Closed Gate):</strong> {{ verification_summary }}</p>
    </div>
  </section>

  <section>
    <h2>4. Değiştirilemez Olay Geçmişi Zaman Çizelgesi (Immutable Defect History)</h2>
    <table>
      <thead>
        <tr>
          <th>Sıra</th>
          <th>Önceki Durum (From)</th>
          <th>Yeni Durum (To)</th>
          <th>Zaman Damgası (Timestamp)</th>
        </tr>
      </thead>
      <tbody>
        {% for h in history %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>{{ h.from_status or "(Oluşturuldu)" }}</td>
          <td><strong>{{ h.to_status }}</strong></td>
          <td>{{ h.at }}</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="4">Geçmiş kaydı bulunmuyor.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <footer>
    SDS-06 Agile Test and Defect Tracking System · IEEE 829 / ISO/IEC/IEEE 29119-3 Test Incident Report · Üreten: {{ generated_by }}
  </footer>
</body>
</html>
