{
  "name": "sds06-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json",
    "test": "node --test tests/i18n.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "node e2e/import-results.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.28.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.33.1",
    "vite": "^7.3.7"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
